# ---------------------------------------------------------------------------
# Jasfer Hosting - environment configuration
# Copy to .env (never commit .env) and fill in what you need.
# ---------------------------------------------------------------------------

# Public base URL of the panel (used for OAuth redirects + absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# 32+ char random string. Signs session cookies and encrypts node API keys.
# Generate with: openssl rand -hex 32
JASFER_SECRET=change-me-please-use-openssl-rand-hex-32

# SQLite database file (created automatically). Defaults to ./data/jasfer.db
JASFER_DB_PATH=./data/jasfer.db

# Where locally-hosted Minecraft servers are stored. Defaults to ./data/servers
JASFER_SERVERS_DIR=./data/servers

# --- Google authentication (optional) --------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local provider (optional) ---------------------------------------------
# Runs Minecraft servers as child processes on this machine with the installed
# Java runtime. Set to "false" to disable.
JASFER_LOCAL_PROVIDER=true
JAVA_BIN=java

# --- Pterodactyl-compatible node (optional) --------------------------------
# The seed script creates a node from these values when both keys are present.
# Application API key: Panel -> Admin -> Application API (needs servers.write)
# Client API key:      Panel -> Account -> API Credentials
PTERODACTYL_PANEL_URL=
PTERODACTYL_APPLICATION_KEY=
PTERODACTYL_CLIENT_KEY=
PTERODACTYL_NODE_ID=1
PTERODACTYL_EGG_ID=1
PTERODACTYL_NEST_ID=1

# --- Bootstrap admin account ----------------------------------------------
# Used by `npm run seed` to create the first administrator.
ADMIN_EMAIL=admin@jasfer.host
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Jasfer Admin
