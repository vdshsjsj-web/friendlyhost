{
  "name": "jasfer-hosting",
  "version": "1.0.0",
  "private": true,
  "description": "Jasfer Hosting - a complete, open-source Minecraft server hosting platform with a real provider adapter layer (local Java runtime + Pterodactyl-compatible nodes).",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "postinstall": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
